<Page x:Class="SMO.Pages.Step1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SMO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step1Page">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300">
            <TextBlock Text="Шаг 1: Выберите тип системы" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <RadioButton Name="RbSingle" Content="Одноканальная СМО" FontSize="14" IsChecked="True"/>
            <RadioButton Name="RbMulti" Content="Многоканальная СМО" FontSize="14" Margin="0,10,0,20"/>

            <Button Content="Далее" Click="NextButton_Click" Height="35" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
